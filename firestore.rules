rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function ownsUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function userProfileKeys() {
      return [
        'uid',
        'email',
        'displayName',
        'photoURL',
        'createdAt',
        'playbackPreferences',
        'playerSettings'
      ];
    }

    function validPlaybackPreferences(data) {
      return !data.keys().hasAny(['playbackPreferences']) || (
        data.playbackPreferences is map
        && data.playbackPreferences.keys().hasOnly(['videoProvider', 'audioLanguage', 'subtitleLanguage', 'subtitleProvider'])
        && data.playbackPreferences.videoProvider in ['nxsha', 'cinesrc', 'videasy']
        && data.playbackPreferences.audioLanguage in ['en', 'ja', 'ko', 'es', 'hi', 'auto', 'off']
        && data.playbackPreferences.subtitleLanguage in ['en', 'ja', 'ko', 'es', 'hi', 'auto', 'off']
        && data.playbackPreferences.subtitleProvider in ['nitro', 'auto']
      );
    }

    function validPlayerSettings(data) {
      return !data.keys().hasAny(['playerSettings']) || (
        data.playerSettings is map
        && data.playerSettings.keys().hasOnly(['autoPlay', 'autoNext', 'skipIntro', 'skipOutro', 'preferredAudio'])
        && data.playerSettings.autoPlay is bool
        && data.playerSettings.autoNext is bool
        && data.playerSettings.skipIntro is bool
        && data.playerSettings.skipOutro is bool
        && data.playerSettings.preferredAudio in ['sub', 'dub']
      );
    }

    // Console-managed administrator markers. Clients may read their own marker,
    // but cannot create, update, or delete admin access.
    match /admins/{userId} {
      allow read: if ownsUser(userId);
      allow write: if false;
    }

    match /users/{userId}/profiles/{profileId} {
      allow read: if ownsUser(userId) || isAdmin();
      allow delete: if ownsUser(userId) || isAdmin();

      allow create, update: if (ownsUser(userId) || isAdmin())
        && request.resource.data.keys().hasOnly([
          'id',
          'name',
          'avatar',
          'movieGenres',
          'seriesGenres',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.id == profileId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 20
        && request.resource.data.avatar is string
        && request.resource.data.avatar in ['panda', 'fox', 'cat', 'bear', 'koala', 'rabbit', 'tiger', 'dog']
        && request.resource.data.movieGenres is list
        && request.resource.data.movieGenres.size() <= 3
        && request.resource.data.seriesGenres is list
        && request.resource.data.seriesGenres.size() <= 3
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string;

      match /progress/{animeId} {
        allow read, write: if ownsUser(userId) || isAdmin();
      }

      match /library/{itemId} {
        allow read, write: if ownsUser(userId) || isAdmin();
      }
    }

    match /users/{userId} {
      // A signed-in user can read their own profile/settings; only admins can delete users.
      allow read: if ownsUser(userId) || isAdmin();
      allow delete: if isAdmin();

      // A user may create their own profile, but cannot assign privileged fields.
      allow create: if ownsUser(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(userProfileKeys())
        && request.resource.data.email == (request.auth.token.email == null ? '' : request.auth.token.email)
        && validPlaybackPreferences(request.resource.data)
        && validPlayerSettings(request.resource.data);

      // Users may update only ordinary profile fields. Privileged fields are not
      // accepted even if legacy documents still contain them.
      allow update: if (
        ownsUser(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(userProfileKeys())
        && request.resource.data.email == (request.auth.token.email == null ? '' : request.auth.token.email)
        && validPlaybackPreferences(request.resource.data)
        && validPlayerSettings(request.resource.data)
      ) || isAdmin();

      match /progress/{animeId} {
        allow read, write: if ownsUser(userId) || isAdmin();
      }

      match /library/{itemId} {
        allow read, write: if ownsUser(userId) || isAdmin();
      }
    }

    // Internal analytics is append-only for clients and readable only by admins.
    // Identity fields are optional for anonymous telemetry but must match the
    // authenticated Firebase token when present.
    match /analytics_events/{eventId} {
      allow create: if request.resource.data.keys().hasOnly([
        'type',
        'path',
        'animeId',
        'animeTitle',
        'episodeId',
        'episodeNumber',
        'durationSeconds',
        'metadata',
        'sessionId',
        'createdAt',
        'clientTimestamp',
        'uid',
        'userEmail'
      ]) && (
        (request.auth == null
          && !request.resource.data.keys().hasAny(['uid', 'userEmail']))
        ||
        (request.auth != null
          && request.resource.data.get('uid', '') == request.auth.uid
          && request.resource.data.get('userEmail', '') == request.auth.token.email)
      );
      allow read, update, delete: if isAdmin();
    }

    // Support reports may be filed without an account, but only the small
    // validated report schema is accepted. Only administrators can read or triage tickets.
    match /supportTickets/{ticketId} {
      allow create: if request.resource.data.keys().hasOnly([
        'subject', 'message', 'category', 'impact', 'status', 'email',
        'userId', 'page', 'clientTimestamp', 'createdAt'
      ])
        && request.resource.data.subject is string
        && request.resource.data.subject.size() >= 5
        && request.resource.data.subject.size() <= 120
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 15
        && request.resource.data.message.size() <= 5000
        && request.resource.data.category in ['playback', 'account', 'search', 'library', 'performance', 'other']
        && request.resource.data.impact in ['low', 'normal', 'high', 'critical']
        && request.resource.data.status == 'open'
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.userId == (request.auth == null ? 'anonymous' : request.auth.uid)
        && request.resource.data.page is string
        && request.resource.data.page.size() <= 300
        && request.resource.data.clientTimestamp is int
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // No public test collection in production.
    match /test/{docId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
