{
  "name": "panda-fun",
  "private": true,
  "version": "1.3.1",
  "type": "module",
  "description": "Panda.fun streaming app for TV, desktop and mobile",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:android": "tsc -b && vite build --mode android",
    "preview": "vite preview --port 4173",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@bbc/tv-lrud-spatial": "0.0.18",
    "@fontsource-variable/inter": "5.3.0",
    "preact": "10.29.8",
    "qrcode-generator": "1.5.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "swr": "2.5.1",
    "wouter": "3.13.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "happy-dom": "21.0.4",
    "three": "^0.187.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.5"
    }
  }
}
