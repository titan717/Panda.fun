{
  "name": "panda-fun",
  "private": true,
  "version": "1.1.4",
  "type": "module",
  "description": "Panda.fun streaming app for TV, desktop and mobile",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:android": "tsc -b && vite build --mode android",
    "preview": "vite preview --port 4173",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@bbc/tv-lrud-spatial": "^0.0.18",
    "@fontsource-variable/inter": "^5.3.0",
    "preact": "^10.29.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "swr": "^2.5.1",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.65.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "happy-dom": "^20.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  }
}
