<?xml version="1.0" encoding="utf-8"?>
<!-- Cold-start window: the blueprint splash gradient (BLUEPRINT_SPEC §2) with the Panda mark, so there is no flash before the web splash paints. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="315" android:startColor="#0B2A6B" android:centerColor="#13306E" android:endColor="#7A1430" />
        </shape>
    </item>
    <item>
        <bitmap android:gravity="center" android:src="@drawable/splash_mark" />
    </item>
</layer-list>
