<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.KinomaTV" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_window</item>
        <item name="colorPrimary">@color/tv_accent</item>
        <item name="colorAccent">@color/tv_accent</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="Theme.KinomaTV.Player" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:keepScreenOn">true</item>
    </style>
</resources>
