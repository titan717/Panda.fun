rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function ownsUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function userProfileKeys() {
      return [
        'uid',
        'email',
        'displayName',
        'photoURL',
        'createdAt'
      ];
    }

    // Console-managed administrator markers. Clients may read their own marker,
    // but cannot create, update, or delete admin access.
    match /admins/{userId} {
      allow read: if ownsUser(userId);
      allow write: if false;
    }

    match /users/{userId}/profiles/{profileId} {
      allow read: if ownsUser(userId) || isAdmin();
      allow delete: if ownsUser(userId) || isAdmin();

      allow create, update: if (ownsUser(userId) || isAdmin())
        && request.resource.data.keys().hasOnly([
          'id',
          'name',
          'avatar',
          'pinHash',
          'movieGenres',
          'seriesGenres',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.id == profileId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 20
        && request.resource.data.avatar is string
        && request.resource.data.avatar in ['panda', 'fox', 'cat', 'bear', 'koala', 'rabbit', 'tiger', 'dog']
        && request.resource.data.movieGenres is list
        && request.resource.data.movieGenres.size() <= 3
        && request.resource.data.seriesGenres is list
        && request.resource.data.seriesGenres.size() <= 3
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && (!request.resource.data.keys().hasAny(['pinHash'])
          || (request.resource.data.pinHash is string && request.resource.data.pinHash.size() == 64));      
    }

    match /users/{userId} {
      // Admins may read/manage users for the protected dashboard.
      allow read, delete: if isAdmin();

      // A user may create their own profile, but cannot assign privileged fields.
      allow create: if ownsUser(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(userProfileKeys())
        && request.resource.data.email == (request.auth.token.email == null ? '' : request.auth.token.email);

      // Users may update only ordinary profile fields. Privileged fields are not
      // accepted even if legacy documents still contain them.
      allow update: if (
        ownsUser(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(userProfileKeys())
        && request.resource.data.email == (request.auth.token.email == null ? '' : request.auth.token.email)
      ) || isAdmin();

      match /progress/{animeId} {
        allow read, write: if ownsUser(userId) || isAdmin();
      }

      match /library/{itemId} {
        allow read, write: if ownsUser(userId) || isAdmin();
      }
    }

    // Internal analytics is append-only for clients and readable only by admins.
    // Identity fields are optional for anonymous telemetry but must match the
    // authenticated Firebase token when present.
    match /analytics_events/{eventId} {
      allow create: if request.resource.data.keys().hasOnly([
        'type',
        'path',
        'animeId',
        'animeTitle',
        'episodeId',
        'episodeNumber',
        'durationSeconds',
        'metadata',
        'sessionId',
        'createdAt',
        'clientTimestamp',
        'uid',
        'userEmail'
      ]) && (
        (request.auth == null
          && !request.resource.data.keys().hasAny(['uid', 'userEmail']))
        ||
        (request.auth != null
          && request.resource.data.get('uid', '') == request.auth.uid
          && request.resource.data.get('userEmail', '') == request.auth.token.email)
      );
      allow read, update, delete: if isAdmin();
    }

    // No public test collection in production.
    match /test/{docId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
